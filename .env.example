# 至少配置一个站点的 API Key。两个都配置时：先调国际站，失败再调国内站。

# 国际站 https://www.minimax.io （接口地址 https://api.minimax.io）
MINIMAX_INTL_API_KEY=
# 可选：旧版账号需要 GroupId 时填写
MINIMAX_INTL_GROUP_ID=

# 国内站 https://platform.minimaxi.com （接口地址 https://api.minimaxi.com）
MINIMAX_CN_API_KEY=
MINIMAX_CN_GROUP_ID=

# 语音模型，默认 speech-2.8-hd，一般不用改
MINIMAX_MODEL=speech-2.8-hd

# 可选：访问密码。设置后网页和接口都需要提供该密码
ACCESS_TOKEN=

# 可选：监听端口，默认 3000
PORT=3000
